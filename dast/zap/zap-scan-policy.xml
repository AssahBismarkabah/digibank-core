<?xml version="1.0" encoding="UTF-8"?>
<!--
  DigiBank - OWASP ZAP Active Scan Policy
  =========================================
  Purpose : Define a focused, baseline-appropriate active scan policy for the
            initial DAST campaign (Workshop 3, §2.14 / §4.9).

  Design choices
  - Strength  = LOW  - enough to surface findings without long scan times
  - Threshold = LOW  - report more findings; students decide relevance
  - Only the rule categories most relevant to a REST banking API are enabled:
      - Missing / weak HTTP security headers
      - Application error / information disclosure
      - Server banner leakage
      - Basic injection probes (SQL, path traversal)
  - Rules that are noisy on a local dev build (e.g., Viewstate for ASP.NET)
    are disabled.

  After the hardening tickets are merged, raise Strength to MEDIUM and
  Threshold to MEDIUM, then switch fail_action to "true" in the CI job.
-->
<policy>
  <name>digibank-baseline</name>
  <description>
    Focused baseline policy for DigiBank DAST: headers, error disclosure, and
    information exposure checks at LOW strength / LOW threshold.
  </description>

  <!-- === Passive scan rules: security headers and information leakage === -->

  <!-- 10010: Secure Pages Include Mixed Content -->
  <scanner>
    <id>10010</id>
    <enabled>true</enabled>
    <level>LOW</level>
    <strength>LOW</strength>
  </scanner>

  <!-- 10011: Cookie Without Secure Flag -->
  <scanner>
    <id>10011</id>
    <enabled>true</enabled>
    <level>LOW</level>
    <strength>LOW</strength>
  </scanner>

  <!-- 10015: Incomplete or No Cache-control Header Set -->
  <scanner>
    <id>10015</id>
    <enabled>true</enabled>
    <level>LOW</level>
    <strength>LOW</strength>
  </scanner>

  <!-- 10019: Content-Type Header Missing -->
  <scanner>
    <id>10019</id>
    <enabled>true</enabled>
    <level>LOW</level>
    <strength>LOW</strength>
  </scanner>

  <!-- 10020: Anti-clickjacking Header (X-Frame-Options) -->
  <scanner>
    <id>10020</id>
    <enabled>true</enabled>
    <level>LOW</level>
    <strength>LOW</strength>
