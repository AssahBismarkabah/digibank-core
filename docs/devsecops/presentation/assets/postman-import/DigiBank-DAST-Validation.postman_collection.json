{
  "info": {
    "name": "DigiBank DAST Validation",
    "description": "Security-oriented API test collection for the DigiBank DAST campaign (Workshop 3).\n\nCovers:\n  - Happy-path smoke for customers, accounts, transactions and compliance\n  - Input validation boundaries (negative/zero amounts, empty fields, invalid email)\n  - Error response shape (checks that no stack trace / class names leak)\n  - Security header assertions (X-Content-Type-Options, etc.)\n  - Not-found / 404 response envelope quality (incl. compliance)\n  - Generic-error assertions (no raw ids echoed from 404/invalid responses)\n\nEnvironments (same key set, different baseUrl):\n  - DigiBank-local.postman_environment.json  (http://127.0.0.1:8080)\n  - DigiBank-dev.postman_environment.json    (https://dev.digibank.internal)\n  - DigiBank-prod.postman_environment.json   (https://api.digibank.example)\n\nRun with Newman (see dast/postman/newman-run.sh):\n  npx newman run DigiBank-DAST-Validation.postman_collection.json \\\n    --environment DigiBank-local.postman_environment.json \\\n    --reporters cli,json,html",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.2.0"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{gatewayAdminUsername}}", "type": "string" },
      { "key": "password", "value": "{{gatewayAdminPassword}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "1 – Happy path",
      "description": "Establish a minimal data set and verify normal business behaviour is intact.",
      "item": [
        {
          "name": "1.1 Create customer (valid)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('email', 'dast.' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('response is JSON', () => pm.response.to.be.json);",
                  "const body = pm.response.json();",
                  "pm.test('id is a number', () => pm.expect(body.id).to.be.a('number'));",
                  "pm.environment.set('customerId', body.id);",
                  "",
                  "// Security: no stack trace or exception class names",
                  "const raw = pm.response.text();",
                  "pm.test('no stack trace in 201 response', () => {",
                  "  pm.expect(raw).to.not.include('at com.');",
                  "  pm.expect(raw).to.not.include('Exception');",
                  "  pm.expect(raw).to.not.include('Caused by');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"DAST\",\n  \"lastName\": \"Customer\",\n  \"email\": \"{{email}}\"\n}"
            },
            "url": "{{baseUrl}}/api/customers"
          }
        },
        {
          "name": "1.2 List customers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "",
                  "// Security header checks",
                  "pm.test('X-Content-Type-Options header present', () => {",
                  "  const h = pm.response.headers.get('X-Content-Type-Options');",
                  "  pm.expect(h).to.not.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/customers"
          }
        },
        {
          "name": "1.3 Get customer by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('id matches', () => pm.expect(body.id).to.eql(pm.environment.get('customerId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/customers/{{customerId}}"
          }
        },
        {
          "name": "1.4 Create account (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('accountId present', () => pm.expect(body.id).to.be.a('number'));",
                  "pm.environment.set('accountId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"DAST-{{customerId}}-{{$randomInt}}\",\n  \"balance\": 1000,\n  \"customerId\": {{customerId}},\n  \"accountType\": \"CHECKING\",\n  \"currency\": \"EUR\"\n}"
            },
            "url": "{{baseUrl}}/api/accounts"
          }
        },
        {
          "name": "1.5 Deposit transaction (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('transaction id present', () => pm.expect(body.id).to.be.a('number'));",
                  "pm.environment.set('transactionId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": {{accountId}},\n  \"amount\": 25,\n  \"transactionType\": \"DEPOSIT\",\n  \"description\": \"DAST deposit\"\n}"
            },
            "url": "{{baseUrl}}/api/transactions"
          }
        },
        {
          "name": "1.6 Index page",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          }
        }
      ]
    },
    {
      "name": "2 – Input validation (negative / boundary)",
      "description": "Verify server-side validation rejects invalid input and that the error envelope does not leak internal details.",
      "item": [
        {
          "name": "2.1 Create customer – empty body fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('response is JSON', () => pm.response.to.be.json);",
                  "const raw = pm.response.text();",
                  "",
                  "// DAST check: error body must not leak class names or stack traces",
                  "pm.test('no Java class name in 400 response', () => {",
                  "  pm.expect(raw).to.not.match(/com\\.digibank/);",
                  "  pm.expect(raw).to.not.match(/org\\.springframework/);",
                  "  pm.expect(raw).to.not.match(/java\\.lang/);",
                  "});",
                  "pm.test('no stack trace in 400 response', () => {",
                  "  pm.expect(raw).to.not.include('at com.');",
                  "  pm.expect(raw).to.not.include('Caused by');",
                  "});",
                  "pm.test('no SQL in 400 response', () => {",
                  "  pm.expect(raw.toLowerCase()).to.not.include('select ');",
                  "  pm.expect(raw.toLowerCase()).to.not.include('insert ');",
                  "  pm.expect(raw.toLowerCase()).to.not.include('constraint');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"\",\n  \"lastName\": \"\",\n  \"email\": \"invalid-email\"\n}"
            },
            "url": "{{baseUrl}}/api/customers"
          }
        },
        {
          "name": "2.2 Create customer – missing required fields (null email)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 or 422', () => {",
                  "  pm.expect([400, 422]).to.include(pm.response.code);",
                  "});",
                  "const raw = pm.response.text();",
                  "pm.test('no stack trace', () => {",
                  "  pm.expect(raw).to.not.include('at com.');",
                  "  pm.expect(raw).to.not.include('Exception');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\"\n}"
            },
            "url": "{{baseUrl}}/api/customers"
          }
        },
        {
          "name": "2.3 Create account – negative balance",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Application may accept or reject negative balance – observe the actual behaviour",
                  "pm.test('response received', () => pm.expect(pm.response.code).to.be.oneOf([201, 400, 422]));",
                  "const raw = pm.response.text();",
                  "pm.test('no stack trace in response', () => {",
                  "  pm.expect(raw).to.not.include('at com.');",
                  "  pm.expect(raw).to.not.include('Exception');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"NEG-TEST-001\",\n  \"balance\": -500,\n  \"customerId\": {{customerId}},\n  \"accountType\": \"CHECKING\",\n  \"currency\": \"EUR\"\n}"
            },
            "url": "{{baseUrl}}/api/accounts"
          }
        },
        {
          "name": "2.4 Create transaction – negative amount",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('response received', () => pm.expect(pm.response.code).to.be.oneOf([201, 400, 422]));",
                  "const raw = pm.response.text();",
                  "pm.test('no stack trace in response', () => {",
                  "  pm.expect(raw).to.not.include('at com.');",
                  "  pm.expect(raw).to.not.include('Exception');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": {{accountId}},\n  \"amount\": -250,\n  \"transactionType\": \"WITHDRAWAL\",\n  \"description\": \"DAST negative amount probe\"\n}"
            },
            "url": "{{baseUrl}}/api/transactions"
          }
        },
        {
          "name": "2.5 Create transaction – zero amount",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('response received', () => pm.expect(pm.response.code).to.be.oneOf([201, 400, 422]));",
                  "const raw = pm.response.text();",
                  "pm.test('no stack trace', () => {",
                  "  pm.expect(raw).to.not.include('at com.');",
                  "  pm.expect(raw).to.not.include('Exception');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": {{accountId}},\n  \"amount\": 0,\n  \"transactionType\": \"DEPOSIT\",\n  \"description\": \"DAST zero amount probe\"\n}"
            },
            "url": "{{baseUrl}}/api/transactions"
          }
        },
        {
          "name": "2.6 Malformed JSON body",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Malformed JSON is rejected as a client-side request error",
                  "// generic envelope with no stack trace / exception class leakage.",
                  "pm.test('400 generic error for malformed JSON', () => {",
                  "  pm.expect(pm.response.code).to.eql(400);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.message).to.be.a('string');",
                  "});",
                  "const raw = pm.response.text();",
                  "pm.test('no stack trace in malformed-JSON response', () => {",
                  "  pm.expect(raw).to.not.include('at com.');",
                  "  pm.expect(raw).to.not.include('HttpMessageNotReadableException');",
                  "  pm.expect(raw).to.not.include('Caused by');",
                  "});",
                  "pm.test('no Java class name in malformed-JSON response', () => {",
                  "  pm.expect(raw).to.not.match(/com\\.digibank/);",
                  "  pm.expect(raw).to.not.match(/org\\.springframework/);",
                  "  pm.expect(raw).to.not.match(/java\\.lang/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ this is : not valid json }"
            },
            "url": "{{baseUrl}}/api/customers"
          }
        }
      ]
    },
    {
      "name": "3 – Not-found / 404 quality",
      "description": "Verify that 404 responses do not disclose internal identifiers, SQL, or stack traces.",
      "item": [
        {
          "name": "3.1 GET customer – non-existent id (random probe)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Randomized, non-existent probe id so this test is always a genuine 404",
                  "pm.environment.set('probeId', Date.now() + 99999);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "const raw = pm.response.text();",
                  "",
                  "// DAST check: 404 must not reveal internal path or SQL",
                  "pm.test('no stack trace in 404', () => {",
                  "  pm.expect(raw).to.not.include('at com.');",
                  "  pm.expect(raw).to.not.include('Exception');",
                  "  pm.expect(raw).to.not.include('Caused by');",
                  "});",
                  "pm.test('no Java class name in 404', () => {",
                  "  pm.expect(raw).to.not.match(/com\\.digibank/);",
                  "  pm.expect(raw).to.not.match(/org\\.springframework/);",
                  "  pm.expect(raw).to.not.match(/java\\.lang/);",
                  "});",
                  "pm.test('no SQL in 404', () => {",
                  "  pm.expect(raw.toLowerCase()).to.not.include('select ');",
                  "  pm.expect(raw.toLowerCase()).to.not.include('where ');",
                  "});",
                  "pm.test('no internal path in 404', () => {",
                  "  pm.expect(raw).to.not.match(/\\/home\\//);",
                  "  pm.expect(raw).to.not.match(/\\/opt\\//);",
                  "  pm.expect(raw).to.not.match(/\\/app\\//);",
                  "});",
                  "",
                  "// DAST baseline: the generic 404 must NOT echo the raw probed id.",
                  "// Currently the app returns 'Customer not found with id: <probeId>', so",
                  "// this assertion is expected to FAIL until the hardening ticket replaces",
                  "// the message with a generic string. Documented baseline, not a regression.",
                  "pm.test('[DAST] 404 does not echo raw probe id', () => {",
                  "  const probe = String(pm.environment.get('probeId'));",
                  "  pm.expect(raw).to.not.include(probe);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/customers/{{probeId}}"
          }
        },
        {
          "name": "3.2 GET account – non-existent id (random probe)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('probeId', Date.now() + 99999);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "const raw = pm.response.text();",
                  "pm.test('no stack trace in 404', () => {",
                  "  pm.expect(raw).to.not.include('at com.');",
                  "  pm.expect(raw).to.not.include('Exception');",
                  "});",
                  "pm.test('no Java class name in 404', () => {",
                  "  pm.expect(raw).to.not.match(/com\\.digibank/);",
                  "  pm.expect(raw).to.not.match(/org\\.springframework/);",
                  "});",
                  "pm.test('[DAST] 404 does not echo raw probe id', () => {",
                  "  const probe = String(pm.environment.get('probeId'));",
                  "  pm.expect(raw).to.not.include(probe);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/{{probeId}}"
          }
        },
        {
          "name": "3.3 GET transaction – non-existent id (random probe)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('probeId', Date.now() + 99999);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "const raw = pm.response.text();",
                  "pm.test('no stack trace in 404', () => {",
                  "  pm.expect(raw).to.not.include('at com.');",
                  "  pm.expect(raw).to.not.include('Exception');",
                  "});",
                  "pm.test('no Java class name in 404', () => {",
                  "  pm.expect(raw).to.not.match(/com\\.digibank/);",
                  "  pm.expect(raw).to.not.match(/org\\.springframework/);",
                  "});",
                  "pm.test('[DAST] 404 does not echo raw probe id', () => {",
                  "  const probe = String(pm.environment.get('probeId'));",
                  "  pm.expect(raw).to.not.include(probe);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/transactions/{{probeId}}"
          }
        }
      ]
    },
    {
      "name": "4 – Security header assertions",
      "description": "Verify that common security response headers are present. These will initially FAIL until the hardening tickets are applied – that is expected and provides the baseline delta.",
      "item": [
        {
          "name": "4.1 X-Content-Type-Options on customers list",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "// These tests document EXPECTED headers (may fail pre-hardening)",
                  "pm.test('[DAST] X-Content-Type-Options: nosniff', () => {",
                  "  const h = pm.response.headers.get('X-Content-Type-Options');",
                  "  pm.expect(h, 'X-Content-Type-Options header').to.not.be.null;",
                  "  pm.expect(h.toLowerCase()).to.include('nosniff');",
                  "});",
                  "",
                  "pm.test('[DAST] X-Frame-Options header present', () => {",
                  "  const h = pm.response.headers.get('X-Frame-Options');",
                  "  pm.expect(h, 'X-Frame-Options header').to.not.be.null;",
                  "});",
                  "",
                  "// Baseline observation – log but don't hard-fail",
                  "const server = pm.response.headers.get('Server');",
                  "pm.test('[DAST][INFO] Server header value', () => {",
                  "  console.log('Server header:', server || '(not present)');",
                  "  pm.expect(true).to.be.true; // always pass – informational only",
                  "});",
                  "",
                  "const powered = pm.response.headers.get('X-Powered-By');",
                  "pm.test('[DAST][INFO] X-Powered-By header value', () => {",
                  "  console.log('X-Powered-By header:', powered || '(not present)');",
                  "  pm.expect(true).to.be.true; // informational",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/customers"
          }
        },
        {
          "name": "4.2 Swagger UI accessibility",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// PENDING: the repo has no springdoc/OpenAPI dependency yet, so",
                  "// GET /swagger-ui.html returns 404 today. This assertion is",
                  "// intentionally skipped until the API-docs hardening ticket lands.",
                  "// Once springdoc is added, remove the 404 branch to make this test",
                  "// assert Swagger is reachable (200 or 302) in the dev profile.",
                  "if (pm.response.code === 404) {",
                  "  pm.test('[DAST][SKIPPED] Swagger UI (pending springdoc dependency), got 404', () => {",
                  "    console.log('Swagger UI not present – skipping until springdoc hardening ticket lands');",
                  "    pm.expect(true).to.be.true;",
                  "  });",
                  "} else {",
                  "  pm.test('Swagger UI accessible in dev (200 or 302)', () => {",
                  "    pm.expect([200, 302]).to.include(pm.response.code);",
                  "  });",
                  "",
                  "  const raw = pm.response.text();",
                  "  pm.test('[DAST] Swagger does not expose server internals', () => {",
                  "    pm.expect(raw).to.not.include('/opt/jboss');",
                  "    pm.expect(raw).to.not.include('/home/');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/swagger-ui.html"
          }
        }
      ]
    },
    {
      "name": "5 – Compliance scenarios (nominal + invalid)",
      "description": "Compliance is a first-class domain in DigiBank. These scenarios verify the\nnominal create/list/get flow, exercise server-side validation with invalid\npayloads, and confirm that error envelopes for missing resources are generic\n(no raw ids, class names or stack traces leaked). Relies on {{customerId}}\nas seeded in the happy-path section.",
      "item": [
        {
          "name": "5.1 Create compliance check (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('response is JSON', () => pm.response.to.be.json);",
                  "const body = pm.response.json();",
                  "pm.test('id is a number', () => pm.expect(body.id).to.be.a('number'));",
                  "pm.test('server-set checkDate present', () => pm.expect(body.checkDate).to.be.a('string'));",
                  "pm.environment.set('complianceId', body.id);",
                  "",
                  "// Security: no stack trace or exception class names",
                  "const raw = pm.response.text();",
                  "pm.test('no stack trace in 201 response', () => {",
                  "  pm.expect(raw).to.not.include('at com.');",
                  "  pm.expect(raw).to.not.include('Exception');",
                  "  pm.expect(raw).to.not.include('Caused by');",
                  "});",
                  "pm.test('no Java class name in 201 response', () => {",
                  "  pm.expect(raw).to.not.match(/com\\.digibank/);",
                  "  pm.expect(raw).to.not.match(/org\\.springframework/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"checkType\": \"KYC\",\n  \"status\": \"PASSED\",\n  \"checkedBy\": \"officer@digibank\",\n  \"remarks\": \"DAST nominal KYC check\"\n}"
            },
            "url": "{{baseUrl}}/api/compliance"
          }
        },
        {
          "name": "5.2 List compliance checks",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/compliance"
          }
        },
        {
          "name": "5.3 Get compliance check by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('id matches', () => pm.expect(body.id).to.eql(pm.environment.get('complianceId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/compliance/{{complianceId}}"
          }
        },
        {
          "name": "5.4 Get compliance by customer (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/compliance/by-customer/{{customerId}}"
          }
        },
        {
          "name": "5.5 Create compliance check – empty required fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('response is JSON', () => pm.response.to.be.json);",
                  "const body = pm.response.json();",
                  "pm.test('generic validation envelope', () => {",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.message).to.eql('Validation failed');",
                  "  pm.expect(body.violations).to.be.an('object');",
                  "});",
                  "const raw = pm.response.text();",
                  "pm.test('no Java class name in 400 response', () => {",
                  "  pm.expect(raw).to.not.match(/com\\.digibank/);",
                  "  pm.expect(raw).to.not.match(/org\\.springframework/);",
                  "  pm.expect(raw).to.not.match(/java\\.lang/);",
                  "});",
                  "pm.test('no stack trace in 400 response', () => {",
                  "  pm.expect(raw).to.not.include('at com.');",
                  "  pm.expect(raw).to.not.include('Caused by');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"checkType\": \"\",\n  \"status\": \"\",\n  \"checkedBy\": \"\"\n}"
            },
            "url": "{{baseUrl}}/api/compliance"
          }
        },
        {
          "name": "5.6 Create compliance check – missing customerId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('generic validation envelope', () => {",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.message).to.eql('Validation failed');",
                  "  pm.expect(body.violations.customerId).to.not.be.undefined;",
                  "});",
                  "const raw = pm.response.text();",
                  "pm.test('no stack trace', () => {",
                  "  pm.expect(raw).to.not.include('at com.');",
                  "  pm.expect(raw).to.not.include('Exception');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"checkType\": \"AML\",\n  \"status\": \"PENDING\",\n  \"checkedBy\": \"officer@digibank\"\n}"
            },
            "url": "{{baseUrl}}/api/compliance"
          }
        },
        {
          "name": "5.7 GET compliance – non-existent id (random probe)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('probeId', Date.now() + 99999);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "const raw = pm.response.text();",
                  "pm.test('no stack trace in 404', () => {",
                  "  pm.expect(raw).to.not.include('at com.');",
                  "  pm.expect(raw).to.not.include('Exception');",
                  "  pm.expect(raw).to.not.include('Caused by');",
                  "});",
                  "pm.test('no Java class name in 404', () => {",
                  "  pm.expect(raw).to.not.match(/com\\.digibank/);",
                  "  pm.expect(raw).to.not.match(/org\\.springframework/);",
                  "});",
                  "pm.test('[DAST] 404 does not echo raw probe id', () => {",
                  "  const probe = String(pm.environment.get('probeId'));",
                  "  pm.expect(raw).to.not.include(probe);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/compliance/{{probeId}}"
          }
        }
      ]
