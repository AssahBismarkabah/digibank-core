@startuml Digi Bank - Discovery and Configuration
skinparam monochrome true
skinparam shadowing false
skinparam componentStyle uml2
skinparam linetype ortho
title Digi Bank\nDiscovery and Configuration Boundaries

node "Platform services" as platform {
  component "Config Server\nservice settings" as config
  component "Discovery Server\nservice registry" as discovery
  config -[hidden]right- discovery
}

node "Business services" as services {
  component "Customer Service" as customer
  component "Account Service" as account
  component "Transaction Service" as transaction
  component "Compliance Service" as compliance
  component "API Gateway" as gateway
  customer -[hidden]right- account
  account -[hidden]right- transaction
  transaction -[hidden]right- compliance
  compliance -[hidden]right- gateway
}

artifact "Environment variables\n(local / CI overrides)" as env

env ..> config : override
config --> customer : configuration
config --> account : configuration
config --> transaction : configuration
config --> compliance : configuration
config --> gateway : configuration

customer --> discovery : register
account --> discovery : register
transaction --> discovery : register
compliance --> discovery : register
gateway --> discovery : lookup

note bottom
  The project uses lightweight HTTP boundaries for the workshop.
  Docker Compose provides the local service host and startup order.
end note
@enduml
