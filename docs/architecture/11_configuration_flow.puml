@startuml Digi Bank - Configuration Flow
skinparam monochrome true
skinparam shadowing false
skinparam componentStyle uml2
skinparam linetype ortho
title Digi Bank\nCentralized Configuration Flow

artifact "Environment variables\nlocal / CI overrides" as env
component "Config Server\n:8888" as config

node "Business services" as services {
  component "API Gateway" as gateway
  component "Customer Service" as customer
  component "Account Service" as account
  component "Transaction Service" as transaction
  component "Compliance Service" as compliance
}

env ..> config : override
config --> gateway : gateway settings
config --> customer : customer settings
config --> account : account settings
config --> transaction : transaction settings
config --> compliance : compliance settings

note bottom
  Services read their settings from the lightweight HTTP config boundary.
  Environment variables can override local values in CI or Compose.
end note
@enduml
