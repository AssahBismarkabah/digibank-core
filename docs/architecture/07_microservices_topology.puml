@startuml Digi Bank - Microservices Topology
skinparam monochrome true
skinparam shadowing false
skinparam componentStyle uml2
skinparam linetype ortho
title Digi Bank\nMicroservices Topology

actor Client
node "API Gateway\n:8080" as gateway

node "Customer Service\n:8081" as customer {
  component "Customer REST API" as customerApi
  database "customer-db" as customerDb
  customerApi --> customerDb
}
node "Account Service\n:8082" as account {
  component "Account REST API" as accountApi
  database "account-db" as accountDb
  accountApi --> accountDb
}
node "Transaction Service\n:8083" as transaction {
  component "Transaction REST API" as transactionApi
  database "transaction-db" as transactionDb
  transactionApi --> transactionDb
}
node "Compliance Service\n:8084" as compliance {
  component "Compliance REST API" as complianceApi
  database "compliance-db" as complianceDb
  complianceApi --> complianceDb
}
node "Notification Service\n:8085" as notification

node "Platform services" as platform {
  component "Discovery Server\n:8761" as discovery
  component "Config Server\n:8888" as config
}

Client --> gateway : HTTPS / REST
gateway --> customerApi : /api/customers
gateway --> accountApi : /api/accounts
gateway --> transactionApi : /api/transactions
gateway --> complianceApi : /api/compliance
gateway --> notification : /api/notifications

note right of platform
  Shared platform boundaries for
  discovery and configuration.
end note

customer -[hidden]right- account
account -[hidden]right- transaction
transaction -[hidden]right- compliance
compliance -[hidden]right- notification
@enduml
