@startuml Digi Bank - Distributed Patterns
skinparam monochrome true
skinparam shadowing false
skinparam componentStyle uml2
skinparam linetype ortho
title Digi Bank\nDistributed Patterns in Transaction Service

node "Transaction Service" as transaction {
  component "TransactionController" as controller
  component "TransactionService\ncommand / write path" as command
  component "TransactionQueryService\nquery / read path" as query
  component "TransferSagaService" as saga
  database "transaction-db" as db

  controller --> command : command
  controller --> query : query
  command --> db : write
  query --> db : read
  command --> saga : transfer
}

component "Compliance Service" as compliance
component "Account Service" as account
component "Circuit Breaker" as breaker
component "Notification Service" as notification

command --> compliance : validate
saga --> account : debit / credit
saga ..> account : compensate on failure
saga --> breaker : notify
breaker --> notification : call
breaker ..> notification : fallback

note bottom
  CQRS separates reads from writes. Saga coordinates a transfer.
  Circuit Breaker protects notification calls when the dependency is unavailable.
end note
@enduml
